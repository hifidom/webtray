#!/bin/sh
# Stop running WebTray instances (the installed ones) before removal and
# before a package upgrade (postinst starts the new version afterwards).
set -e

case "$1" in
    remove | upgrade | deconfigure)
        # console script cmdline: "/usr/bin/python3 /usr/bin/webtray"
        # (the path pattern does not match dev/venv installs)
        pkill -f '/usr/bin/webtray' 2>/dev/null || true
        ;;
esac

#DEBHELPER#

exit 0
